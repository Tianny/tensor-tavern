# Hify 部署配置（复制为 .env 后修改；三个密码必填，其余按需）
#   cp .env.example .env

# ---- 必填：三个持久化组件的密码 ----
MYSQL_PASSWORD=change-me-mysql
REDIS_PASSWORD=change-me-redis
PGVECTOR_PASSWORD=change-me-pg

# ---- 可选 ----
# 时区（datetime 字段时区）
#TZ=Asia/Shanghai

# 前端对外端口（默认 80）
#WEB_PORT=80

# JVM 参数（内存上限 / 内网出网代理）
#JAVA_OPTS=-Xms512m -Xmx1024m
# 内网环境后端访问外部 LLM API 走代理：
#JAVA_OPTS=-Xmx1024m -Dhttps.proxyHost=proxy.example.com -Dhttps.proxyPort=8080 -Dhttp.proxyHost=proxy.example.com -Dhttp.proxyPort=8080
